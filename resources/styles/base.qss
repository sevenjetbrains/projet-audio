/* Feuille de style d'AudioCut Studio.
   Gabarit : chaque nom precede d un dollar est remplace par la couleur
   correspondante de la palette du theme (app/config/palette.py). */

/* Le fond n'est posé que sur les conteneurs : un fond sur QWidget peindrait un
   rectangle derriere chaque libelle, par-dessus la couleur de son panneau. */
QWidget {
    color: $text;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox, QProgressDialog, QInputDialog, QFileDialog {
    background-color: $bg;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: $card;
    color: $text;
    border: 1px solid $border_strong;
    padding: 5px 8px;
}

/* --- Barre de titre applicative ------------------------------------------ */

#appTitleBar {
    background-color: $titlebar;
    border-bottom: 1px solid $border;
}

#appTitle {
    color: $accent;
    font-size: 14px;
    font-weight: 600;
}

#projectName {
    color: $text_muted;
    font-size: 12px;
}

/* --- Menus ---------------------------------------------------------------- */

QMenuBar {
    background-color: $titlebar;
    color: $text_muted;
    border: none;
    padding: 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:disabled {
    color: $text_faint;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: $field;
    color: $text;
}

QMenu {
    background-color: $card;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: $field_hover;
}

QMenu::item:disabled {
    color: $text_faint;
}

QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: 5px 8px;
}

/* --- Barre d outils ------------------------------------------------------- */

#toolBar {
    background-color: $titlebar;
    border-bottom: 1px solid $border;
}

#toolBarSeparator {
    background-color: $border_strong;
    max-width: 1px;
}

/* --- Colonnes et cartes --------------------------------------------------- */

#sidePanel, #rightPanel {
    background-color: $surface;
    border: none;
}

#sidePanel {
    border-right: 1px solid $border;
}

#rightPanel {
    border-left: 1px solid $border;
}

#centerPanel {
    background-color: $bg;
}

QFrame[card="true"] {
    background-color: $card;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame[card="soft"] {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame[card="success"] {
    background-color: $success_soft;
    border: 1px solid $success;
    border-radius: 10px;
}

#sectionLabel {
    color: $text_muted;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

#hintLabel {
    color: $text_faint;
    font-size: 11px;
}

#mutedLabel {
    color: $text_muted;
    font-size: 12px;
}

#valueLabel {
    color: $text;
    font-size: 12px;
    font-family: "Cascadia Mono", "Consolas", monospace;
}

#titleLabel {
    color: $text;
    font-size: 13px;
    font-weight: 600;
}

#timecodeLabel {
    color: $text;
    font-size: 15px;
    font-weight: 600;
    font-family: "Cascadia Mono", "Consolas", monospace;
}

#timecodeTotalLabel {
    color: $text_faint;
    font-size: 15px;
    font-family: "Cascadia Mono", "Consolas", monospace;
}

/* --- Vignettes (badges) --------------------------------------------------- */

QLabel[badge="neutral"] {
    background-color: $field;
    color: $text_muted;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[badge="success"] {
    background-color: $success_soft;
    color: $success;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[badge="accent"] {
    background-color: $accent_soft;
    color: $accent;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}

/* --- Boutons -------------------------------------------------------------- */

QPushButton {
    background-color: $field;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: $field_hover;
}

QPushButton:pressed {
    background-color: $border;
}

QPushButton:disabled {
    color: $text_faint;
    border-color: $border;
    background-color: $surface;
}

QPushButton[accent="true"] {
    background-color: $accent;
    color: $text_on_accent;
    border: 1px solid $accent;
    font-weight: 600;
}

QPushButton[accent="true"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}

QPushButton[accent="true"]:pressed {
    background-color: $accent_pressed;
    border-color: $accent_pressed;
}

QPushButton[accent="true"]:disabled {
    background-color: $field;
    color: $text_faint;
    border-color: $border;
}

/* Bouton ne portant qu'un glyphe : le remplissage generique le tronquerait. */
QPushButton[icon="true"] {
    padding: 0px;
    font-size: 14px;
}

QPushButton[flat="true"] {
    background: transparent;
    border: 1px solid transparent;
    color: $text_muted;
}

QPushButton[flat="true"]:hover {
    background-color: $field;
    color: $text;
}

QPushButton[danger="true"]:hover {
    background-color: $accent_soft;
    color: $accent;
    border-color: $accent;
}

QToolButton {
    background-color: transparent;
    color: $text;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 12px;
}

QToolButton:hover {
    background-color: $field;
}

QToolButton:pressed {
    background-color: $border;
}

QToolButton:disabled {
    color: $text_faint;
}

QToolButton[accent="true"] {
    background-color: $accent;
    color: $text_on_accent;
    font-weight: 600;
}

QToolButton[accent="true"]:hover {
    background-color: $accent_hover;
}

QToolButton[accent="true"]:disabled {
    background-color: $field;
    color: $text_faint;
}

/* --- Champs de saisie ----------------------------------------------------- */

QDoubleSpinBox, QSpinBox, QLineEdit, QComboBox {
    background-color: $field;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 12px;
    selection-background-color: $accent;
    selection-color: $text_on_accent;
}

QDoubleSpinBox:focus, QSpinBox:focus, QLineEdit:focus, QComboBox:focus {
    border-color: $accent;
}

QDoubleSpinBox:disabled, QSpinBox:disabled, QLineEdit:disabled, QComboBox:disabled {
    color: $text_faint;
    background-color: $surface;
}

QDoubleSpinBox[timecode="true"], QLineEdit[timecode="true"] {
    font-family: "Cascadia Mono", "Consolas", monospace;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    width: 14px;
    background-color: transparent;
    border: none;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid $text_muted;
    width: 0px;
    height: 0px;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid $text_muted;
    width: 0px;
    height: 0px;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid $text_muted;
    width: 0px;
    height: 0px;
}

QComboBox QAbstractItemView {
    background-color: $card;
    border: 1px solid $border_strong;
    border-radius: 8px;
    selection-background-color: $field_hover;
    outline: none;
}

/* --- Curseurs (position, volume) ------------------------------------------ */

QSlider::groove:horizontal {
    height: 4px;
    background-color: $field;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: $accent;
    border-radius: 2px;
}

QSlider[plain="true"]::sub-page:horizontal {
    background-color: $border_strong;
}

QSlider::handle:horizontal {
    background-color: $text;
    border: none;
    width: 11px;
    height: 11px;
    margin: -4px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal:hover {
    background-color: $accent;
}

/* --- Liste des sequences -------------------------------------------------- */

#sequenceTableHeader {
    color: $text_faint;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    border: none;
    color: $text;
}

/* --- Barre de progression ------------------------------------------------- */

QProgressBar {
    background-color: $field;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: $accent;
    border-radius: 3px;
}

QProgressBar[tone="success"]::chunk {
    background-color: $success;
}

/* --- Barre d etat --------------------------------------------------------- */

QStatusBar {
    background-color: $titlebar;
    border-top: 1px solid $border;
    color: $text_faint;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: $text_faint;
    font-size: 11px;
}

/* --- Ascenseurs ----------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: $border_strong;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: $text_faint;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: $border_strong;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --- Dialogues ------------------------------------------------------------ */

/* Zones défilantes : le fond du dialogue traverse. Sans cette règle, le fond du viewport prenait la couleur claire
   de la palette système (gris clair derrière des cartes sombres en thème sombre). */
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QDialog, QMessageBox {
    background-color: $surface;
}

QDialog QLabel, QMessageBox QLabel {
    color: $text;
}

QGroupBox {
    border: 1px solid $border;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0px 5px;
    color: $text_muted;
}

QCheckBox, QRadioButton {
    color: $text;
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    background-color: $field;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: $accent;
    border-color: $accent;
}

/* --- Ecran d accueil ------------------------------------------------------ */

#welcomePanel {
    background-color: $bg;
}

#welcomeSide {
    background-color: $surface;
    border-left: 1px solid $border;
}

#heroTitle {
    color: $text;
    font-size: 30px;
    font-weight: 700;
}

#heroText {
    color: $text_muted;
    font-size: 14px;
}

#dropZone {
    background-color: transparent;
    border: 1px dashed $border_strong;
    border-radius: 12px;
}

#dropZone[hover="true"] {
    background-color: $card;
    border: 1px dashed $accent;
}

#dropIcon {
    background-color: $field;
    border: 1px solid $border;
    border-radius: 14px;
}

#dropTitle {
    color: $text;
    font-size: 18px;
    font-weight: 600;
}

#footerHint {
    color: $text_faint;
    font-size: 11px;
}

#pathLabel {
    color: $text_faint;
    font-family: "Consolas", "Cascadia Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
}

QLabel[kbd="true"] {
    color: $text_muted;
    background-color: $field;
    border: 1px solid $border;
    border-radius: 4px;
    font-family: "Consolas", "Cascadia Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    padding: 1px 5px;
}

QFrame[card="warning"] {
    background-color: $warning_soft;
    border: 1px solid $warning;
    border-radius: 10px;
}

QFrame[card="recent"] {
    background-color: $card;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame[card="recent"]:hover {
    background-color: $field_hover;
    border: 1px solid $border_strong;
}

#recentName {
    color: $text;
    font-size: 13px;
    font-weight: 600;
}

#warningTitle {
    color: $text;
    font-size: 13px;
    font-weight: 600;
}

#accentValue {
    color: $accent;
    font-size: 12px;
    font-weight: 600;
}

QPushButton[warning="true"] {
    background-color: $warning;
    border: 1px solid $warning;
    color: $text_on_accent;
    font-weight: 600;
}

QPushButton[warning="true"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}

/* --- Fenetre de traitement audio ------------------------------------------ */

#dialogHeader {
    background-color: $titlebar;
    border-bottom: 1px solid $border;
}

#dialogFooter {
    background-color: $titlebar;
    border-top: 1px solid $border;
}

#dialogTitle {
    color: $text;
    font-size: 22px;
    font-weight: 700;
}

#dialogSubtitle {
    color: $text_muted;
    font-size: 12px;
}

#profilesColumn {
    background-color: $surface;
    border-right: 1px solid $border;
}

QFrame[profile="false"], QFrame[profile="true"] {
    background-color: $card;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame[profile="false"]:hover {
    background-color: $field_hover;
    border-color: $border_strong;
}

QFrame[profile="true"] {
    background-color: $accent_soft;
    border: 1px solid $accent;
}

#profileName {
    color: $text;
    font-size: 14px;
}

#profileNameSelected {
    color: $accent;
    font-size: 14px;
    font-weight: 600;
}

#cardTitle {
    color: $text;
    font-size: 15px;
    font-weight: 600;
}

#cardHint {
    color: $text_faint;
    font-size: 12px;
}

#settingName {
    color: $text;
    font-size: 13px;
}

#settingHint {
    color: $text_faint;
    font-size: 11px;
}

#sliderName {
    color: $text_muted;
    font-size: 13px;
}

#valueMono {
    color: $text;
    font-family: "Consolas", "Cascadia Mono", "DejaVu Sans Mono", monospace;
    font-size: 13px;
}

#footerNote {
    color: $text_faint;
    font-size: 11px;
}

QPushButton[segment="true"] {
    background-color: $field;
    border: 1px solid $border;
    border-radius: 8px;
    color: $text_muted;
    font-size: 13px;
}

QPushButton[segment="true"]:hover {
    background-color: $field_hover;
    color: $text;
}

QPushButton[segment="true"]:checked {
    background-color: $accent;
    border-color: $accent;
    color: $text_on_accent;
    font-weight: 600;
}

#cardSeparator {
    background-color: $border;
    border: none;
}
